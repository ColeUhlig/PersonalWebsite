-- @module Spectrum (src/shared/Ocean/Spectrum.luau)
local Spectrum = (function()
--!strict
-- Sea spectrum in wavevector space, the input to every cascade's initial state.
-- JONSWAP (fetch-limited), Horvath's tanh depth factor (the "TMA" he ships), finite-depth
-- dispersion, and Donelan-Banner directional spreading with Horvath's swell parameter, which
-- `isotropy` can blend toward uniform when the look wants waves from every direction.
-- Formulas: docs/research/tessendorf-fft.md section 1.10. All angular frequencies are in
-- radians per second; theta is measured from the wind direction.

type Params = {
	windSpeed: number, -- metres per second at 10 m
	fetch: number, -- metres of open water the wind has blown across
	depth: number, -- metres
	gamma: number, -- JONSWAP peak enhancement, 3.3 is the canonical value
	swell: number, -- 0 .. 1, Horvath: narrows spreading into long parallel trains
	windDirection: number, -- radians from +x toward +z
	gravity: number,
	-- Shape knobs. The spectrum above is physical; a physical sea read as glass at game scale,
	-- so these two exaggerate it. Both are applied in `variance`, so every cascade sees them.
	scale: number, -- visual amplitude multiplier, 1 = physical (variance scales by scale^2)
	tailBoost: number, -- 0 = the true spectrum; above the peak, energy is multiplied by
	-- (omega / peakOmega) ^ (2 * tailBoost), lifting the short waves
	isotropy: number?, -- 0 = Donelan-Banner (physical), 1 = the same energy from every
	-- direction; between them a linear blend. Optional so older Params literals stay valid.
}

local SIGMA_BELOW_PEAK = 0.07
local SIGMA_ABOVE_PEAK = 0.09
local NORMALISER_STEPS = 128

local Spectrum = {}

Spectrum.NORMAL = table.freeze({
	windSpeed = 12,
	fetch = 80000,
	depth = 60,
	gamma = 3.3,
	swell = 0.3,
	windDirection = 0,
	gravity = 9.81,
	scale = 1, -- physical defaults; tuning changes them
	tailBoost = 0,
	isotropy = 0,
}) :: Params

function Spectrum.peakOmega(p: Params): number
	return 22 * (p.gravity * p.gravity / (p.windSpeed * p.fetch)) ^ (1 / 3)
end

function Spectrum.alpha(p: Params): number
	return 0.076 * (p.windSpeed * p.windSpeed / (p.fetch * p.gravity)) ^ 0.22
end

-- S(omega) in m^2 s / rad.
function Spectrum.jonswap(omega: number, p: Params): number
	local wp = Spectrum.peakOmega(p)
	local sigma = if omega <= wp then SIGMA_BELOW_PEAK else SIGMA_ABOVE_PEAK
	local offset = omega - wp
	local r = math.exp(-(offset * offset) / (2 * sigma * sigma * wp * wp))
	local g = p.gravity
	return Spectrum.alpha(p) * g * g / omega ^ 5 * math.exp(-1.25 * (wp / omega) ^ 4) * p.gamma ^ r
end

-- Kitaigorodskii depth limiting as Horvath ships it: a smooth tanh fit.
function Spectrum.depthFactor(omega: number, p: Params): number
	local wh = omega * math.sqrt(p.depth / p.gravity)
	return 0.5 + 0.5 * math.tanh(1.8 * (wh - 1.125))
end

-- omega^2 = g k tanh(k depth).
function Spectrum.omega(k: number, p: Params): number
	return math.sqrt(p.gravity * k * math.tanh(k * p.depth))
end

function Spectrum.omegaDerivative(k: number, p: Params): number
	local g, d = p.gravity, p.depth
	local kd = k * d
	local sech = 1 / math.cosh(kd)
	return (g * math.tanh(kd) + g * k * d * sech * sech) / (2 * Spectrum.omega(k, p))
end

-- Donelan-Banner width parameter.
function Spectrum.beta(omega: number, p: Params): number
	local ratio = omega / Spectrum.peakOmega(p)
	if ratio < 0.95 then
		return 2.61 * ratio ^ 1.3
	elseif ratio < 1.6 then
		return 2.28 * ratio ^ -1.3
	end
	local epsilon = -0.4 + 0.8393 * math.exp(-0.567 * math.log(ratio * ratio))
	return 10 ^ epsilon
end

-- Unnormalised spreading: sech^2(beta theta) times Horvath's swell shaping
-- cos^(2 s)(theta / 2) with s = 16 tanh(wp / omega) swell^2. Multiply by
-- spreadNormaliser(omega) so the integral over theta is 1.
function Spectrum.spread(omega: number, theta: number, p: Params): number
	local b = Spectrum.beta(omega, p)
	local sech = 1 / math.cosh(b * theta)
	local base = sech * sech
	if p.swell <= 0 then
		return base
	end
	local s = 16 * math.tanh(Spectrum.peakOmega(p) / omega) * p.swell * p.swell
	return base * math.abs(math.cos(theta * 0.5)) ^ (2 * s)
end

-- Numeric, midpoint rule over -pi .. pi. Called once per cell at cascade init only.
function Spectrum.spreadNormaliser(omega: number, p: Params): number
	local width = 2 * math.pi / NORMALISER_STEPS
	local total = 0
	for step = 0, NORMALISER_STEPS - 1 do
		local theta = -math.pi + (step + 0.5) * width
		total += Spectrum.spread(omega, theta, p) * width
	end
	return 1 / total
end

-- Normalised directional factor: Donelan-Banner (with Horvath's swell shaping) blended
-- toward uniform by isotropy. Both parts integrate to one over theta, so the blend does too.
function Spectrum.directional(omega: number, theta: number, p: Params): number
	local isotropy = p.isotropy or 0
	local wind = Spectrum.spread(omega, theta, p) * Spectrum.spreadNormaliser(omega, p)
	return (1 - isotropy) * wind + isotropy / (2 * math.pi)
end

-- Variance per unit wavevector area at (kx, kz): S(omega) depth(omega) D(omega, theta)
-- (d omega / dk) / k. This change of variables is what keeps wave heights physical when
-- a frequency spectrum feeds a wavevector lattice (research note, section 1.10).
-- The two shape knobs land here, and only here, so every cascade and every derived field
-- (heights, displacements, slopes, the Jacobian) picks them up consistently.
function Spectrum.variance(kx: number, kz: number, p: Params): number
	local k = math.sqrt(kx * kx + kz * kz)
	if k == 0 then
		return 0
	end
	local omega = Spectrum.omega(k, p)
	local theta = math.atan2(kz, kx) - p.windDirection
	theta = (theta + math.pi) % (2 * math.pi) - math.pi
	local directional = Spectrum.directional(omega, theta, p)
	local wp = Spectrum.peakOmega(p)
	-- Amplitude is the square root of variance, so a scale of s needs s^2 here.
	local boost = if omega > wp then (omega / wp) ^ (2 * p.tailBoost) else 1
	return Spectrum.jonswap(omega, p)
		* Spectrum.depthFactor(omega, p)
		* directional
		* Spectrum.omegaDerivative(k, p)
		/ k
		* p.scale
		* p.scale
		* boost
end

return table.freeze(Spectrum)
end)()
-- @end Spectrum

-- @module FFT (src/shared/Ocean/FFT.luau)
local FFT = (function()
--!strict
-- Inverse 2-D complex FFT on flat, row-major, 1-based arrays. Iterative radix-2, in place.
-- It evaluates the plain sum x[m] = sum_k X[k] exp(+2 pi i k m / N), with no 1 / N^2
-- scaling, which is the form Tessendorf's equations (36), (37) and (44) take.
-- Hot path: `inverse2D` allocates nothing; it rewrites the arrays it is given.

type Plan = {
	n: number,
	reversed: { number }, -- bit-reversed index for each index, 0-based values
	cosines: { number }, -- cos(2 pi j / n) for j = 0 .. n / 2 - 1
	sines: { number },
}

local FFT = {}

local function isPowerOfTwo(n: number): boolean
	return n >= 2 and n % 1 == 0 and bit32.band(n, n - 1) == 0
end

function FFT.plan(n: number): Plan
	assert(isPowerOfTwo(n), `FFT size must be a power of two and at least 2, got {n}`)
	local bits = math.round(math.log(n, 2))
	local reversed: { number } = table.create(n)
	for index = 0, n - 1 do
		local result, value = 0, index
		for _ = 1, bits do
			result = result * 2 + value % 2
			value = value // 2
		end
		reversed[index + 1] = result
	end
	local half = n // 2
	local cosines: { number }, sines: { number } = table.create(half), table.create(half)
	for j = 0, half - 1 do
		local angle = 2 * math.pi * j / n
		cosines[j + 1] = math.cos(angle)
		sines[j + 1] = math.sin(angle)
	end
	return table.freeze({
		n = n,
		reversed = table.freeze(reversed),
		cosines = table.freeze(cosines),
		sines = table.freeze(sines),
	})
end

-- One length-n inverse transform over the elements at offset + 1 + i * stride, i = 0 .. n-1.
function FFT.inverse1D(plan: Plan, re: { number }, im: { number }, offset: number, stride: number)
	local n = plan.n
	local reversed, cosines, sines = plan.reversed, plan.cosines, plan.sines
	local base = offset + 1

	for index = 0, n - 1 do
		local swapWith = reversed[index + 1]
		if swapWith > index then
			local a, b = base + index * stride, base + swapWith * stride
			re[a], re[b] = re[b], re[a]
			im[a], im[b] = im[b], im[a]
		end
	end

	local size = 2
	while size <= n do
		local half = size // 2
		local twiddleStep = n // size
		local halfStride = half * stride
		for start = 0, n - 1, size do
			local twiddle = 1
			local a = base + start * stride
			for _ = 1, half do
				local b = a + halfStride
				local c, s = cosines[twiddle], sines[twiddle]
				local br, bi = re[b], im[b]
				local tr = br * c - bi * s
				local ti = br * s + bi * c
				local ar, ai = re[a], im[a]
				re[b], im[b] = ar - tr, ai - ti
				re[a], im[a] = ar + tr, ai + ti
				twiddle += twiddleStep
				a += stride
			end
		end
		size *= 2
	end
end

-- Rows (along x) then columns (along z). Both arrays must hold n * n numbers.
function FFT.inverse2D(plan: Plan, re: { number }, im: { number })
	local n = plan.n
	for row = 0, n - 1 do
		FFT.inverse1D(plan, re, im, row * n, 1)
	end
	for column = 0, n - 1 do
		FFT.inverse1D(plan, re, im, column, n)
	end
end

return table.freeze(FFT)
end)()
-- @end FFT

-- @module Cascade (src/shared/Ocean/Cascade.luau)
local Cascade = (function()
--!strict
--!native
-- One Tessendorf FFT patch: the initial spectrum for a band of wavenumbers, time evolution
-- with quantised (looping) dispersion, four packed inverse FFTs into eight real fields, and
-- bilinear sampling with wrap. Formulas: docs/research/tessendorf-fft.md section 1.
-- Hot paths (`evolve`, `synthesise`, `sample`, `sampleNoJacobian`) allocate nothing.


type Config = {
	n: number, -- cells per side, a power of two
	size: number, -- patch length in studs (metres)
	kMin: number, -- wavenumber band [kMin, kMax); the finest cascade uses math.huge
	kMax: number,
	seed: number,
	loopPeriod: number, -- seconds; every frequency becomes a multiple of 2 pi / loopPeriod
	params: Spectrum.Params,
}

-- What the samplers need: any table with these fields. A Cascade satisfies it; so do the
-- FieldStore's display tables (M2).
type Fields = {
	n: number,
	size: number,
	height: { number },
	dispX: { number },
	dispZ: { number },
	slopeX: { number },
	slopeZ: { number },
	jxx: { number },
	jzz: { number },
	jxz: { number },
}

type Cascade = {
	n: number,
	size: number,
	cells: number,
	time: number, -- the time the fields hold; -1 before the first synthesis
	-- Per cell, fixed at creation:
	kx: { number },
	kz: { number },
	h0Re: { number }, -- h~0(k)
	h0Im: { number },
	h0MirrorRe: { number }, -- conj(h~0(-k))
	h0MirrorIm: { number },
	omega: { number }, -- quantised dispersion
	unitKx: { number }, -- kx / |k|, 0 at k = 0
	unitKz: { number },
	invK: { number }, -- 1 / |k|, 0 at k = 0
	-- Per cell, rewritten by evolve (4 packed spectra) and synthesise (8 fields):
	spectrumRe: { { number } },
	spectrumIm: { { number } },
	height: { number },
	dispX: { number },
	dispZ: { number },
	slopeX: { number },
	slopeZ: { number },
	jxx: { number },
	jzz: { number },
	jxz: { number },
}

local PACKED = 4

local Cascade = {}

local function gaussianPair(random: Random): (number, number)
	-- Box-Muller. NextNumber() may return 0, which log() rejects.
	local u1 = 1 - random:NextNumber()
	local u2 = random:NextNumber()
	local radius = math.sqrt(-2 * math.log(u1))
	local angle = 2 * math.pi * u2
	return radius * math.cos(angle), radius * math.sin(angle)
end

local function zeros(count: number): { number }
	return table.create(count, 0)
end

function Cascade.new(config: Config): Cascade
	local n, size = config.n, config.size
	assert(n >= 2 and bit32.band(n, n - 1) == 0, `n must be a power of two, got {n}`)
	local cells = n * n
	local dk = 2 * math.pi / size
	local nyquist = math.pi * n / size
	local kMax = math.min(config.kMax, nyquist)
	local omega0 = 2 * math.pi / config.loopPeriod
	local random = Random.new(config.seed)

	local kx, kz = zeros(cells), zeros(cells)
	local h0Re, h0Im = zeros(cells), zeros(cells)
	local omega = zeros(cells)
	local unitKx, unitKz, invK = zeros(cells), zeros(cells), zeros(cells)

	for row = 0, n - 1 do
		local nz = if row < n / 2 then row else row - n
		for column = 0, n - 1 do
			local nx = if column < n / 2 then column else column - n
			local index = row * n + column + 1
			local x, z = nx * dk, nz * dk
			kx[index], kz[index] = x, z
			local k = math.sqrt(x * x + z * z)
			-- Draw the gaussians for every cell, in a fixed order, so the band mask never
			-- changes which random numbers a cell receives.
			local xiRe, xiIm = gaussianPair(random)
			if k > 0 then
				invK[index] = 1 / k
				unitKx[index], unitKz[index] = x / k, z / k
				omega[index] = math.floor(Spectrum.omega(k, config.params) / omega0) * omega0
				if k >= config.kMin and k < kMax then
					-- Eq 42, with the modal energy split across the two conjugate terms eq 43
					-- adds: h~0 = (1 / 2)(xi_r + i xi_i) sqrt(P(k) dk^2), so E|h~0|^2 is
					-- P dk^2 / 2 and E|h~|^2 is P dk^2. Tessendorf's bare 1 / sqrt 2 leaves
					-- the field with twice the spectrum's variance under discrete Parseval.
					local amplitude =
						math.sqrt(Spectrum.variance(x, z, config.params) * dk * dk / 4)
					h0Re[index], h0Im[index] = xiRe * amplitude, xiIm * amplitude
				end
			end
		end
	end

	local h0MirrorRe, h0MirrorIm = zeros(cells), zeros(cells)
	for row = 0, n - 1 do
		for column = 0, n - 1 do
			local index = row * n + column + 1
			local mirror = ((n - row) % n) * n + ((n - column) % n) + 1
			h0MirrorRe[index], h0MirrorIm[index] = h0Re[mirror], -h0Im[mirror]
		end
	end

	local spectrumRe, spectrumIm = {}, {}
	for slot = 1, PACKED do
		spectrumRe[slot], spectrumIm[slot] = zeros(cells), zeros(cells)
	end

	return {
		n = n,
		size = size,
		cells = cells,
		time = -1,
		kx = kx,
		kz = kz,
		h0Re = h0Re,
		h0Im = h0Im,
		h0MirrorRe = h0MirrorRe,
		h0MirrorIm = h0MirrorIm,
		omega = omega,
		unitKx = unitKx,
		unitKz = unitKz,
		invK = invK,
		spectrumRe = spectrumRe,
		spectrumIm = spectrumIm,
		height = zeros(cells),
		dispX = zeros(cells),
		dispZ = zeros(cells),
		slopeX = zeros(cells),
		slopeZ = zeros(cells),
		jxx = zeros(cells),
		jzz = zeros(cells),
		jxz = zeros(cells),
	}
end

-- Eq 43 with the sign of w t flipped: under the e^{+i k.x} synthesis, h0(k) e^{-i w t}
-- travels toward +k (downwind), matching the swells' k.x - w t. The paper's e^{+i w t} would
-- send a directional sea upwind (found in the M1 final review, 2026-09-17).
-- Then the derived spectra, packed two per complex array: (height, dispX), (dispZ, slopeX),
-- (slopeZ, jxx), (jzz, jxz). Packing X + iY: re = Xr - Yi, im = Xi + Yr.
function Cascade.evolve(c: Cascade, t: number)
	local h0Re, h0Im, mRe, mIm = c.h0Re, c.h0Im, c.h0MirrorRe, c.h0MirrorIm
	local omega, kx, kz, ux, uz, invK = c.omega, c.kx, c.kz, c.unitKx, c.unitKz, c.invK
	local re1, im1 = c.spectrumRe[1], c.spectrumIm[1]
	local re2, im2 = c.spectrumRe[2], c.spectrumIm[2]
	local re3, im3 = c.spectrumRe[3], c.spectrumIm[3]
	local re4, im4 = c.spectrumRe[4], c.spectrumIm[4]
	local cos, sin = math.cos, math.sin

	for index = 1, c.cells do
		local phase = -omega[index] * t
		local cp, sp = cos(phase), sin(phase)
		-- h~ = h0 (cp + i sp) + m (cp - i sp)
		local hr = (h0Re[index] + mRe[index]) * cp - (h0Im[index] - mIm[index]) * sp
		local hi = (h0Im[index] + mIm[index]) * cp + (h0Re[index] - mRe[index]) * sp

		local x, z = kx[index], kz[index]
		local ex, ez, ik = ux[index], uz[index], invK[index]
		-- dispX~ = i ex h~ = (-ex hi, ex hr); dispZ~ likewise. Gerstner sign: under the +i
		-- synthesis this moves water toward crests, so positive chop pinches them;
		-- Tessendorf's -i does the opposite here.
		local dxRe, dxIm = -ex * hi, ex * hr
		local dzRe, dzIm = -ez * hi, ez * hr
		-- slopeX~ = i x h~ = (-x hi, x hr); slopeZ~ likewise.
		local sxRe, sxIm = -x * hi, x * hr
		local szRe, szIm = -z * hi, z * hr
		-- jxx~ = d(dispX~)/dx = (i x)(i x / k) h~ = -(x^2 / k) h~, and so on: real factors.
		local fxx, fzz, fxz = -x * x * ik, -z * z * ik, -x * z * ik

		re1[index], im1[index] = hr - dxIm, hi + dxRe
		re2[index], im2[index] = dzRe - sxIm, dzIm + sxRe
		re3[index], im3[index] = szRe - fxx * hi, szIm + fxx * hr
		re4[index], im4[index] = fzz * hr - fxz * hi, fzz * hi + fxz * hr
	end
	c.time = t
end

-- Four inverse FFTs, then unpack: real part is the first field of the pair, imaginary the
-- second. Valid because every packed spectrum is Hermitian (research note, section 1.8).
function Cascade.synthesise(c: Cascade, plan: FFT.Plan)
	assert(plan.n == c.n, `plan size {plan.n} does not match cascade size {c.n}`)
	for slot = 1, PACKED do
		FFT.inverse2D(plan, c.spectrumRe[slot], c.spectrumIm[slot])
	end
	local re1, im1 = c.spectrumRe[1], c.spectrumIm[1]
	local re2, im2 = c.spectrumRe[2], c.spectrumIm[2]
	local re3, im3 = c.spectrumRe[3], c.spectrumIm[3]
	local re4, im4 = c.spectrumRe[4], c.spectrumIm[4]
	local height, dispX, dispZ, slopeX = c.height, c.dispX, c.dispZ, c.slopeX
	local slopeZ, jxx, jzz, jxz = c.slopeZ, c.jxx, c.jzz, c.jxz
	for index = 1, c.cells do
		height[index], dispX[index] = re1[index], im1[index]
		dispZ[index], slopeX[index] = re2[index], im2[index]
		slopeZ[index], jxx[index] = re3[index], im3[index]
		jzz[index], jxz[index] = re4[index], im4[index]
	end
end

-- The evolved height spectrum h~(k, c.time) alone, unpacked, into re and im. Used by the
-- packing spec (and by nothing per frame).
function Cascade.heightSpectrum(c: Cascade, re: { number }, im: { number })
	local t = c.time
	for index = 1, c.cells do
		local phase = -c.omega[index] * t
		local cp, sp = math.cos(phase), math.sin(phase)
		re[index] = (c.h0Re[index] + c.h0MirrorRe[index]) * cp
			- (c.h0Im[index] - c.h0MirrorIm[index]) * sp
		im[index] = (c.h0Im[index] + c.h0MirrorIm[index]) * cp
			+ (c.h0Re[index] - c.h0MirrorRe[index]) * sp
	end
end

-- Bilinear corner indices and weights for world offset (x, z), wrapping at the patch size.
-- Works on any table with n, size and the field arrays (Cascade or FieldStore display).
local function corners(
	c: Fields,
	x: number,
	z: number
): (number, number, number, number, number, number, number, number)
	local n = c.n
	local u = (x / c.size * n) % n
	local v = (z / c.size * n) % n
	local column, row = math.floor(u), math.floor(v)
	local fu, fv = u - column, v - row
	local column1, row1 = (column + 1) % n, (row + 1) % n
	local a = row * n + column + 1
	return a,
		row * n + column1 + 1,
		row1 * n + column + 1,
		row1 * n + column1 + 1,
		(1 - fu) * (1 - fv),
		fu * (1 - fv),
		(1 - fu) * fv,
		fu * fv
end

-- Bilinear sample of all eight fields at world offset (x, z) from the patch origin, wrapping
-- at the patch size. Returns height, dispX, dispZ, slopeX, slopeZ, jxx, jzz, jxz.
-- The eight mixes are written out rather than shared through a closure (inlined 2026-09-17
-- after the bench; see docs/research/bench.md).
function Cascade.sample(
	c: Fields,
	x: number,
	z: number
): (number, number, number, number, number, number, number, number)
	local a, b, cIndex, d, wa, wb, wc, wd = corners(c, x, z)
	local height, dispX, dispZ, slopeX = c.height, c.dispX, c.dispZ, c.slopeX
	local slopeZ, jxx, jzz, jxz = c.slopeZ, c.jxx, c.jzz, c.jxz
	return height[a] * wa + height[b] * wb + height[cIndex] * wc + height[d] * wd,
		dispX[a] * wa + dispX[b] * wb + dispX[cIndex] * wc + dispX[d] * wd,
		dispZ[a] * wa + dispZ[b] * wb + dispZ[cIndex] * wc + dispZ[d] * wd,
		slopeX[a] * wa + slopeX[b] * wb + slopeX[cIndex] * wc + slopeX[d] * wd,
		slopeZ[a] * wa + slopeZ[b] * wb + slopeZ[cIndex] * wc + slopeZ[d] * wd,
		jxx[a] * wa + jxx[b] * wb + jxx[cIndex] * wc + jxx[d] * wd,
		jzz[a] * wa + jzz[b] * wb + jzz[cIndex] * wc + jzz[d] * wd,
		jxz[a] * wa + jxz[b] * wb + jxz[cIndex] * wc + jxz[d] * wd
end

-- Height and displacement only (flat lighting needs no slopes). This is the sampler the flat
-- look calls, once per cascade per vertex -- about 50,000 calls a frame at the High tier -- so
-- it works `corners` out for itself rather than calling it: the call and its eight returns were
-- worth about half a millisecond of the write stage (2026-09-19). `sample` and
-- `sampleNoJacobian`, which run on far fewer vertices, still share `corners`, and the spec case
-- "sampleHeight returns the first three values of sampleNoJacobian" pins the two together,
-- wrapped point included.
function Cascade.sampleHeight(c: Fields, x: number, z: number): (number, number, number)
	local n = c.n
	local u = (x / c.size * n) % n
	local v = (z / c.size * n) % n
	local column, row = math.floor(u), math.floor(v)
	local fu, fv = u - column, v - row
	local column1, row1 = (column + 1) % n, (row + 1) % n
	local rowBase, row1Base = row * n, row1 * n
	local a, b = rowBase + column + 1, rowBase + column1 + 1
	local cIndex, d = row1Base + column + 1, row1Base + column1 + 1
	local wa, wb = (1 - fu) * (1 - fv), fu * (1 - fv)
	local wc, wd = (1 - fu) * fv, fu * fv
	local height, dispX, dispZ = c.height, c.dispX, c.dispZ
	return height[a] * wa + height[b] * wb + height[cIndex] * wc + height[d] * wd,
		dispX[a] * wa + dispX[b] * wb + dispX[cIndex] * wc + dispX[d] * wd,
		dispZ[a] * wa + dispZ[b] * wb + dispZ[cIndex] * wc + dispZ[d] * wd
end

-- The five fields the surface needs everywhere: height, displacement and slopes.
function Cascade.sampleNoJacobian(
	c: Fields,
	x: number,
	z: number
): (number, number, number, number, number)
	local a, b, cIndex, d, wa, wb, wc, wd = corners(c, x, z)
	local height, dispX, dispZ, slopeX, slopeZ = c.height, c.dispX, c.dispZ, c.slopeX, c.slopeZ
	return height[a] * wa + height[b] * wb + height[cIndex] * wc + height[d] * wd,
		dispX[a] * wa + dispX[b] * wb + dispX[cIndex] * wc + dispX[d] * wd,
		dispZ[a] * wa + dispZ[b] * wb + dispZ[cIndex] * wc + dispZ[d] * wd,
		slopeX[a] * wa + slopeX[b] * wb + slopeX[cIndex] * wc + slopeX[d] * wd,
		slopeZ[a] * wa + slopeZ[b] * wb + slopeZ[cIndex] * wc + slopeZ[d] * wd
end

-- The three Jacobian fields at world offset (x, z): what the foam field needs and nothing else.
function Cascade.sampleJacobian(c: Fields, x: number, z: number): (number, number, number)
	local a, b, cIndex, d, wa, wb, wc, wd = corners(c, x, z)
	local jxx, jzz, jxz = c.jxx, c.jzz, c.jxz
	return jxx[a] * wa + jxx[b] * wb + jxx[cIndex] * wc + jxx[d] * wd,
		jzz[a] * wa + jzz[b] * wb + jzz[cIndex] * wc + jzz[d] * wd,
		jxz[a] * wa + jxz[b] * wb + jxz[cIndex] * wc + jxz[d] * wd
end

return table.freeze(Cascade)
end)()
-- @end Cascade

-- @module Jacobian (src/shared/Ocean/Jacobian.luau)
local Jacobian = (function()
--!strict
--!native
-- Jacobian of the horizontal displacement (Tessendorf eq 45, 46). Inputs are the three
-- derivative fields dDx/dx, dDz/dz, dDx/dz (equal to dDz/dx) and the choppiness lambda.
-- Determinant 1 is flat water, toward 0 crests pinch, below 0 the surface has folded. The
-- smallest eigenvalue signals folding first, and its eigenvector is the direction the
-- crest is throwing water: the spray direction, for free.

local Jacobian = {}

function Jacobian.determinant(jxx: number, jzz: number, jxz: number, lambda: number): number
	local a, d, b = 1 + lambda * jxx, 1 + lambda * jzz, lambda * jxz
	return a * d - b * b
end

-- Returns the smallest eigenvalue and its unit eigenvector (ex, ez).
function Jacobian.minimum(
	jxx: number,
	jzz: number,
	jxz: number,
	lambda: number
): (number, number, number)
	local a, d, b = 1 + lambda * jxx, 1 + lambda * jzz, lambda * jxz
	local mean, halfDiff = (a + d) / 2, (a - d) / 2
	local radius = math.sqrt(halfDiff * halfDiff + b * b)
	local value = mean - radius
	if radius < 1e-12 then
		return value, 1, 0
	end
	local ex, ez
	if math.abs(b) > 1e-12 then
		ex, ez = b, value - a
	elseif a <= d then
		ex, ez = 1, 0
	else
		ex, ez = 0, 1
	end
	local length = math.sqrt(ex * ex + ez * ez)
	return value, ex / length, ez / length
end

return table.freeze(Jacobian)
end)()
-- @end Jacobian

-- @module WaveSampler (src/shared/Ocean/WaveSampler.luau)
local WaveSampler = (function()
--!strict
--!native
-- Gerstner sum over a wave bank at one point and time. Returns the displacement, the
-- analytic surface normal and the Jacobian as seven numbers (no allocation: this is the
-- per-vertex hot path). The Jacobian is the horizontal area scale of the displaced
-- surface: 1 on flat water, toward 0 where crests pinch, negative where they fold. It
-- drives foam.
-- Same maths as the vertex shader in jonswap-ocean/js/ocean-gpu.js.

local STRIDE = 6

local WaveSampler = {}

-- packed: STRIDE numbers per wave (k, omega, A, phase, dx, dz), the layout both `Jonswap`
-- and `Swells` build. chop scales the lateral term: 1 = full Gerstner, 0 = height only.
-- weights[weightOffset + i] scales the amplitude of wave i; only the first `count` waves are
-- summed, so pass a smaller count to skip waves that have faded out.
-- Returns dx, dy, dz, nx, ny, nz, jacobian.
function WaveSampler.sample(
	packed: { number },
	count: number,
	t: number,
	x: number,
	z: number,
	chop: number,
	weights: { number },
	weightOffset: number
): (number, number, number, number, number, number, number)
	local sin, cos = math.sin, math.cos
	local sumX, sumY, sumZ = 0, 0, 0
	-- Partial derivatives of the displaced position with respect to x and z.
	local xx, xy, xz = 1, 0, 0
	local zx, zy, zz = 0, 0, 1

	for wave = 0, count - 1 do
		local o = wave * STRIDE
		local k, omega = packed[o + 1], packed[o + 2]
		local amplitude = packed[o + 3] * weights[weightOffset + wave + 1]
		local phase, dirX, dirZ = packed[o + 4], packed[o + 5], packed[o + 6]
		local phi = k * (dirX * x + dirZ * z) - omega * t + phase
		local s, c = sin(phi), cos(phi)
		local lateral = amplitude * c * chop
		local kas = k * amplitude * s * chop
		local kac = k * amplitude * c

		sumX += dirX * lateral
		sumY += amplitude * s
		sumZ += dirZ * lateral

		xx -= dirX * dirX * kas
		xy += dirX * kac
		xz -= dirX * dirZ * kas
		zx -= dirX * dirZ * kas
		zy += dirZ * kac
		zz -= dirZ * dirZ * kas
	end

	-- normal = dP/dz x dP/dx
	local nx = zy * xz - zz * xy
	local ny = zz * xx - zx * xz
	local nz = zx * xy - zy * xx
	local length = math.sqrt(nx * nx + ny * ny + nz * nz)
	local jacobian = xx * zz - xz * zx
	return sumX, sumY, sumZ, nx / length, ny / length, nz / length, jacobian
end

-- The packed layout's stride, so a bank builder can lay its numbers out without depending on
-- a particular builder module. `Jonswap.STRIDE` is the same number.
WaveSampler.STRIDE = STRIDE

return table.freeze(WaveSampler)
end)()
-- @end WaveSampler

-- @module Swells (src/shared/Ocean/Swells.luau)
local Swells = (function()
--!strict
--!native
-- Two or three long analytic Gerstner waves outside the FFT. They carry the slow silhouette
-- motion a 256 stud patch cannot hold, break up the FFT's repetition, and are the closed
-- form that buoyancy needs (WaveField.heightAt). Same packed layout as Jonswap's banks so
-- WaveSampler does the work.


type SwellSpec = {
	wavelength: number, -- studs
	amplitude: number, -- studs
	direction: number, -- radians from +x toward +z
	phase: number, -- radians
}

type Bank = {
	packed: { number },
	count: number,
	weights: { number }, -- all 1; WaveSampler requires a weight per wave
	silent: boolean, -- every amplitude is zero, so the whole bank can be skipped
}

local STRIDE = WaveSampler.STRIDE

local Swells = {}

-- Dispersion comes from Spectrum.omega, the same finite-depth relation the cascades use, so
-- a swell and an FFT wave of the same wavelength travel at the same speed.
function Swells.new(list: { SwellSpec }, params: Spectrum.Params, loopPeriod: number): Bank
	assert(#list >= 1, "at least one swell")
	local omega0 = 2 * math.pi / loopPeriod
	local packed: { number } = table.create(#list * STRIDE)
	local weights: { number } = table.create(#list, 1)
	-- Decided here, once, because the surface sampler asks it per patch per frame.
	local silent = true
	for _, swell in list do
		assert(swell.wavelength > 0, `wavelength must be positive, got {swell.wavelength}`)
		if swell.amplitude ~= 0 then
			silent = false
		end
		local k = 2 * math.pi / swell.wavelength
		local omega = math.floor(Spectrum.omega(k, params) / omega0) * omega0
		table.insert(packed, k)
		table.insert(packed, omega)
		table.insert(packed, swell.amplitude)
		table.insert(packed, swell.phase)
		table.insert(packed, math.cos(swell.direction))
		table.insert(packed, math.sin(swell.direction))
	end
	return table.freeze({
		packed = table.freeze(packed),
		count = #list,
		weights = table.freeze(weights),
		silent = silent,
	})
end

-- True when every swell has zero amplitude (the look turned them off), so samplers can skip
-- the bank entirely. Swells.new worked this out; this is a field read.
function Swells.isSilent(bank: Bank): boolean
	return bank.silent
end

-- Returns dx, dy, dz, nx, ny, nz, jacobian (see WaveSampler).
function Swells.sample(
	bank: Bank,
	t: number,
	x: number,
	z: number,
	chop: number
): (number, number, number, number, number, number, number)
	return WaveSampler.sample(bank.packed, bank.count, t, x, z, chop, bank.weights, 0)
end

-- Height only, no lateral displacement: cheap, stateless, identical on every machine.
-- Assumes every weight is 1, which Swells.new guarantees; sample() applies weights,
-- heightAt does not.
function Swells.heightAt(bank: Bank, t: number, x: number, z: number): number
	local packed = bank.packed
	local total = 0
	for wave = 0, bank.count - 1 do
		local o = wave * STRIDE
		local k, omega, amplitude, phase =
			packed[o + 1], packed[o + 2], packed[o + 3], packed[o + 4]
		local dirX, dirZ = packed[o + 5], packed[o + 6]
		total += amplitude * math.sin(k * (dirX * x + dirZ * z) - omega * t + phase)
	end
	return total
end

return table.freeze(Swells)
end)()
-- @end Swells

-- @module WaveField (src/shared/Ocean/WaveField.luau)
local WaveField = (function()
--!strict
-- The sea as one object: FFT cascades (three in the design) that divide the wavenumber
-- range by the 12 pi / L handover rule, plus closed-form swells. `sample` reads the
-- cascades' current tables (whatever time each was last synthesised at) and the swells at
-- the given time; blending between two synthesised times, and the Actor split, are M2's job.
-- The Field is mutable on purpose: `update` rewrites a cascade's tables in place, every
-- frame, so it is not frozen and must not be shared across Actors without a copy.


type Config = {
	params: Spectrum.Params,
	n: number,
	sizes: { number }, -- patch sizes in studs, largest first
	seed: number,
	loopPeriod: number,
	chop: number, -- lambda: scales horizontal displacement and the Jacobian
	swells: { Swells.SwellSpec },
}

type Band = { kMin: number, kMax: number }

type Field = {
	config: Config,
	plan: FFT.Plan,
	cascades: { Cascade.Cascade },
	swells: Swells.Bank,
}

local HANDOVER = 12 * math.pi

local WaveField = {}

-- Cascade i keeps wavenumbers from 12 pi / size_i (0 for the largest) up to 12 pi / size_{i+1}
-- (open above for the smallest; Cascade caps it at Nyquist).
function WaveField.bands(sizes: { number }, n: number): { Band }
	local bands = {}
	for index, size in sizes do
		local nextSize = sizes[index + 1]
		local kMin = if index == 1 then 0 else HANDOVER / size
		local kMax = if nextSize then HANDOVER / nextSize else math.huge
		local nyquist = math.pi * n / size
		assert(
			kMax == math.huge or kMax <= nyquist + 1e-12,
			`cascade {index} ({size} studs) cannot resolve its handover at {kMax}: Nyquist is {nyquist}. Use a smaller size ratio or a larger n`
		)
		table.insert(bands, table.freeze({ kMin = kMin, kMax = kMax }))
	end
	return table.freeze(bands)
end

function WaveField.new(config: Config): Field
	assert(#config.sizes >= 1, "at least one cascade")
	for index = 2, #config.sizes do
		assert(config.sizes[index] < config.sizes[index - 1], "sizes must be largest first")
	end
	local bands = WaveField.bands(config.sizes, config.n)
	local cascades = {}
	for index, size in config.sizes do
		cascades[index] = Cascade.new({
			n = config.n,
			size = size,
			kMin = bands[index].kMin,
			kMax = bands[index].kMax,
			seed = config.seed * 7919 + index,
			loopPeriod = config.loopPeriod,
			params = config.params,
		})
	end
	return {
		config = config,
		plan = FFT.plan(config.n),
		cascades = cascades,
		swells = Swells.new(config.swells, config.params, config.loopPeriod),
	}
end

function WaveField.update(field: Field, index: number, t: number)
	local cascade = field.cascades[index]
	assert(cascade, `no cascade {index}`)
	Cascade.evolve(cascade, t)
	Cascade.synthesise(cascade, field.plan)
end

-- Returns height, dispX, dispZ, slopeX, slopeZ, jacobian at world (x, z).
function WaveField.sample(
	field: Field,
	x: number,
	z: number,
	t: number
): (number, number, number, number, number, number)
	local chop = field.config.chop
	local height, dispX, dispZ, slopeX, slopeZ = 0, 0, 0, 0, 0
	local jxx, jzz, jxz = 0, 0, 0
	for _, cascade in field.cascades do
		local h, dx, dz, sx, sz, xx, zz, xz = Cascade.sample(cascade, x, z)
		height += h
		dispX += dx * chop
		dispZ += dz * chop
		slopeX += sx
		slopeZ += sz
		jxx += xx
		jzz += zz
		jxz += xz
	end
	local swellX, swellY, swellZ = Swells.sample(field.swells, t, x, z, chop)
	return height + swellY,
		dispX + swellX,
		dispZ + swellZ,
		slopeX,
		slopeZ,
		Jacobian.determinant(jxx, jzz, jxz, chop)
end

-- The gameplay query: closed form, stateless, agrees on every machine.
function WaveField.heightAt(field: Field, x: number, z: number, t: number): number
	return Swells.heightAt(field.swells, t, x, z)
end

return table.freeze(WaveField)
end)()
-- @end WaveField

-- @module FoamField (src/shared/Ocean/FoamField.luau)
local FoamField = (function()
--!strict
--!native
-- The foam that falls out of the Jacobian.
--
-- The sea's own is newGrid, stepRows and sample: ONE field over the whole tile at a texel to the
-- stud, half the colour map's own texels, whose every texel runs the fold test on the SUM of all
-- three cascades' derivatives, sampled bilinearly off each cascade's own lattice. That sum is
-- Tessendorf's Jacobian of the total displacement, the only quantity that says whether the water at
-- a point has folded; one cascade's own J says only whether its own band of wavelengths has, which
-- is why nothing below a cascade's cell could show up before. 2Retr0 (GodotOceanWaves) runs the
-- same test per cascade at the FFT's own 1024 texels on the GPU, 8.6 cm a texel on their 88 m
-- tile; a CPU affords 256 texels over a 256-stud tile, a quarter of the rows a frame. The
-- accumulation is theirs: `foam = clamp(foam * decay + grow * max(0, whitecap - J), 0, 1)`.
--
-- A texel sits AT world (i * tile / texels, j * tile / texels) and not half a texel in, the cascade
-- lattice's own convention: a texel has to draw its foam where the fold that made it is, and a half
-- would slide the whole veil off the crests by half a texel.
--
-- new and at are the plain texel field: one float per texel, no stepping of its own, which is the
-- shape the maps worker's coverage mirror takes and the peak mask reads through `at`.


-- The fold test's three: J below the whitecap grows foam, in proportion to how far below it is.
type StepParams = {
	whitecap: number, -- the determinant a texel has to fall under before it foams at all
	grow: number, -- what one step adds where J is a whole whitecap under the cap
	decay: number, -- what a texel keeps of itself per step
}

type Field = {
	texels: number,
	-- The studs the field tiles over, which is the cascade's own size on a grid field and the
	-- reason sample takes world studs. A plain texel field has none: it is only ever read by texel.
	size: number?,
	foam: buffer, -- f32 per texel, (j * texels + i) * 4
	-- A second buffer of the same shape, which nothing reads any more: it was the previous field a
	-- blur read back. `new` still sizes one; a grid field and the coverage mirror pass it empty.
	scratch: buffer,
}

local FoamField = {}

local BYTES = 4

function FoamField.new(texels: number): Field
	local bytes = texels * texels * BYTES
	return {
		texels = texels,
		foam = buffer.create(bytes),
		scratch = buffer.create(bytes),
	}
end

-- One cascade's field, on that cascade's own grid: `texels` is the cascade's `n` and `size` its
-- tile in studs, so the field wraps where the cascade does and sample takes world studs.
function FoamField.newGrid(texels: number, size: number): Field
	return {
		texels = texels,
		size = size,
		foam = buffer.create(texels * texels * BYTES),
		-- Nothing reads a grid field back, so there is nothing for a scratch to hold. An empty
		-- buffer says that louder than a second field nothing ever touches.
		scratch = buffer.create(0),
	}
end

function FoamField.at(field: Field, i: number, j: number): number
	return buffer.readf32(field.foam, (j * field.texels + i) * BYTES)
end

-- One update of the field's rows `rowStart .. rowStart + rowCount - 1`, the quarter the caller is
-- about to paint over. At each texel the three derivatives of every cascade in `cascades` are
-- sampled at that texel's world position and SUMMED, and the fold test runs on that one Jacobian.
-- Returns the mean over the texels it stepped, which is the coverage the report line prints.
function FoamField.stepRows(
	field: Field,
	rowStart: number,
	rowCount: number,
	fields: { Cascade.Fields },
	cascades: { number },
	tile: number,
	chop: number,
	params: StepParams
): number
	local texels = field.texels
	-- Once a step, never per texel: `if ... then error`, whose message is only built when it throws.
	if rowStart < 0 or rowStart + rowCount > texels then
		error("the rows to step are not inside the foam field")
	end
	local foam = field.foam
	local whitecap, grow, decay = params.whitecap, params.grow, params.decay
	local determinant = Jacobian.determinant
	local sample = Cascade.sampleJacobian
	local studs = tile / texels -- one texel, and the step between two world positions
	local count = #cascades
	local total = 0
	for j = rowStart, rowStart + rowCount - 1 do
		local z = j * studs
		local rowBase = j * texels
		for i = 0, texels - 1 do
			local x = i * studs
			-- The cascades' derivatives add, as the displacements they came from do: what folds is
			-- the total surface, and a crest that only pinches in one band never reaches the cap.
			local jxx, jzz, jxz = 0, 0, 0
			for index = 1, count do
				local cxx, czz, cxz = sample(fields[cascades[index]], x, z)
				jxx += cxx
				jzz += czz
				jxz += cxz
			end
			local offset = (rowBase + i) * BYTES
			local fold = determinant(jxx, jzz, jxz, chop)
			local old = buffer.readf32(foam, offset)
			local value = math.clamp(old * decay + grow * math.max(0, whitecap - fold), 0, 1)
			buffer.writef32(foam, offset, value)
			total += value
		end
	end
	return total / (rowCount * texels)
end

-- Bilinear sample of a grid field at a world position in studs, wrapping at the field's size.
-- The cells come one for one from the cascade's own lattice, whose cell (i, j) sits AT world
-- (i * size / texels, j * size / texels) and not half a cell in (Cascade.corners works the same
-- position out with no half taken off), so no half is taken off here either: a foamed cell has to
-- draw its foam where the fold that made it is.
function FoamField.sample(field: Field, x: number, z: number): number
	local texels = field.texels
	-- A cast and not a nil test: the optional is there for the whole-tile field above, a grid field
	-- always carries its size, and this runs at every texel of every band of the colour map.
	local size = field.size :: number
	local u = x / size * texels
	local v = z / size * texels
	local column, row = math.floor(u), math.floor(v)
	local fu, fv = u - column, v - row
	local column0, column1 = column % texels, (column + 1) % texels
	local rowBase, row1Base = (row % texels) * texels, ((row + 1) % texels) * texels
	local foam = field.foam
	return buffer.readf32(foam, (rowBase + column0) * BYTES) * (1 - fu) * (1 - fv)
		+ buffer.readf32(foam, (rowBase + column1) * BYTES) * fu * (1 - fv)
		+ buffer.readf32(foam, (row1Base + column0) * BYTES) * (1 - fu) * fv
		+ buffer.readf32(foam, (row1Base + column1) * BYTES) * fu * fv
end

return table.freeze(FoamField)
end)()
-- @end FoamField

-- @module WaterColour (src/shared/Ocean/WaterColour.luau)
local WaterColour = (function()
--!strict
--!native
-- The colour map: Rare's deep water colour, tinted toward the sub-surface colour by height
-- (a mild version of the height ramp the vertex colours used to paint, so the form reads when the
-- sun is behind you). The view-dependent half of Rare's blend is the emissive glow, not this map.
--
-- Two pieces, and no foam in either: `lut` is the deep-to-subsurface table the tint indexes, and
-- `base` paints the water colour through it, three bytes a texel. That base is what the colour
-- worker's bands start from; the foam goes over it, at the colour map's own finer texels, in
-- FoamPaint.band.


local WaterColour = {}

local function byte(value: number): number
	return math.clamp(math.floor(value * 255 + 0.5), 0, 255)
end

-- 256 RGB triples from deep (0) to subsurface (255).
function WaterColour.lut(deep: Color3, subsurface: Color3): buffer
	local out = buffer.create(256 * 3)
	for k = 0, 255 do
		local colour = deep:Lerp(subsurface, k / 255)
		buffer.writeu8(out, k * 3, byte(colour.R))
		buffer.writeu8(out, k * 3 + 1, byte(colour.G))
		buffer.writeu8(out, k * 3 + 2, byte(colour.B))
	end
	return out
end

-- The water colour on its own: three bytes a texel, no alpha and no foam. It is the base
-- FoamPaint.band upsamples to the colour map's own texels, and the foam is not painted here
-- because at these texels it could only be the blanket the finer map exists to break up.
function WaterColour.base(
	out: buffer,
	texels: number,
	tile: number,
	fields: { Cascade.Fields },
	cascades: { number },
	peak: number,
	tint: number,
	lut: buffer
): ()
	local step = tile / texels
	local inversePeak = if peak > 0 then 1 / peak else 0
	-- The ramp is written out rather than shared with a helper: it runs at every texel of the map,
	-- and a call per texel is work the painter has no frame for.
	for j = 0, texels - 1 do
		local z = (j + 0.5) * step
		for i = 0, texels - 1 do
			local x = (i + 0.5) * step
			local height = 0
			for _, cascadeIndex in cascades do
				height += (Cascade.sampleHeight(fields[cascadeIndex], x, z))
			end
			local t = math.clamp((height * inversePeak + 1) * 0.5, 0, 1)
			local entry = math.floor(tint * t * 255 + 0.5) * 3
			local offset = (j * texels + i) * 3
			buffer.writeu8(out, offset, buffer.readu8(lut, entry))
			buffer.writeu8(out, offset + 1, buffer.readu8(lut, entry + 1))
			buffer.writeu8(out, offset + 2, buffer.readu8(lut, entry + 2))
		end
	end
end

return table.freeze(WaterColour)
end)()
-- @end WaterColour

-- @module PeakMask (src/shared/Ocean/PeakMask.luau)
local PeakMask = (function()
--!strict
--!native
-- The wave-peak mask: one grey byte per texel of the 256-stud tile, the summed HEIGHT of the
-- listed cascades above the mean surface, clamped at zero, normalised by a running maximum and
-- bent by gamma. Painted on the painter worker into the EmissiveMask; the per-patch
-- EmissiveStrength supplies the view-and-sun half.
--
-- Rare's own sentence names the choppiness, not the height: "the wave peak mask is generated
-- from the FFT choppiness vertex offsets; where the choppiness offset is greater, this
-- corresponds to wave peaks". That was taken literally, shipped, and then MEASURED against our
-- fields on 2026-09-20 (Edit, time 12): the choppiness magnitude |D| = |(dispX, dispZ)| is
-- uncorrelated with the height (corr -0.01 on cascade 1), and its brightest tenth of texels sits
-- at a mean height of 0.26 studs on waves reaching 12.9, half of them below sea level. For a
-- Gerstner or FFT wave the horizontal offset is 90 degrees out of phase with the height, so |D|
-- peaks on the FLANKS and is zero at the crests and the troughs: the mask lit the sides of every
-- wave and no strength could make the tops glow. The height above the mean surface is what
-- their last clause is about anyway, since that is where light travels the shortest distance
-- through the water. The other candidate for "peaks" is the Jacobian compression, M4's foam
-- input; untested here.


local PeakMask = {}

PeakMask.DECAY = 0.98 -- the running maximum's hysteresis per fill

-- The magnitudes between the two passes of `fill`. A module-level upvalue, so it is one buffer
-- per module instance (the painter requires its own copy), grown on first use, never per texel.
local scratch: buffer? = nil

function PeakMask.nextMax(previous: number, found: number, decay: number): number
	return math.max(found, previous * decay)
end

-- Returns the largest magnitude seen; dMax <= 0 normalises by that maximum (first fill). That
-- maximum is the sea's tallest crest and ignores the foam: with a foam field a covered texel is
-- held down in the BYTE alone, because foam is painted over the crest it came from and that crest
-- must not glow through it, while the scale the rest of the map divides by has to stay still.
-- Holding it down before the maximum too (as this did until 2026-09-21) tied the scale to the
-- foam: every cap that covered the tallest crest brightened the whole map and every one that
-- dissolved dimmed it again, so the glow pumped at the foam's own rate (Cole, Play: the sea was
-- "super flickery").
function PeakMask.fill(
	out: buffer,
	texels: number,
	tile: number,
	fields: { Cascade.Fields },
	cascades: { number },
	dMax: number,
	gamma: number,
	foam: FoamField.Field?
): number
	if foam ~= nil then
		-- Once, here: the field's `at` does not wrap, so a field of another size would read the
		-- wrong texel across the whole map or run off the end halfway through it.
		assert(foam.texels == texels, "the foam field is not the mask's size")
	end
	local step = tile / texels
	local count = texels * texels
	-- Two passes: the scale is not known until every texel has been sampled, and `out` holds
	-- bytes, so the magnitudes wait in the scratch buffer as floats. It grows on demand and is
	-- kept, so a steady texel count allocates on the first fill only.
	local bytes = count * 4
	local held = scratch
	local magnitudes = if held ~= nil and buffer.len(held) >= bytes
		then held
		else buffer.create(bytes)
	scratch = magnitudes
	local found = 0
	for j = 0, texels - 1 do
		local z = (j + 0.5) * step
		for i = 0, texels - 1 do
			local x = (i + 0.5) * step
			local h = 0
			for _, cascadeIndex in cascades do
				-- Parenthesised, so the height is all that comes back and the two displacements
				-- beside it are dropped without a name each.
				h += (Cascade.sampleHeight(fields[cascadeIndex], x, z))
			end
			-- Everything at or below the mean surface is black: a trough has no thin water for the
			-- light to come through, and a signed value would light the deepest ones brightest.
			local magnitude = math.max(h, 0)
			-- The maximum first, from the bare height: the suppression below says what this texel
			-- is worth under its foam, not what the map is measured against.
			if magnitude > found then
				found = magnitude
			end
			if foam ~= nil then
				magnitude *= 1 - FoamField.at(foam, i, j)
			end
			buffer.writef32(magnitudes, (j * texels + i) * 4, magnitude)
		end
	end
	local scale = if dMax > 0 then dMax else found
	local inverse = if scale > 0 then 1 / scale else 0
	for index = 0, count - 1 do
		local value = math.clamp(buffer.readf32(magnitudes, index * 4) * inverse, 0, 1) ^ gamma
		local byte = math.floor(value * 255 + 0.5)
		local offset = index * 4
		buffer.writeu8(out, offset, byte)
		buffer.writeu8(out, offset + 1, byte)
		buffer.writeu8(out, offset + 2, byte)
		buffer.writeu8(out, offset + 3, 255)
	end
	return found
end

return table.freeze(PeakMask)
end)()
-- @end PeakMask

-- @module FieldStore (src/shared/Ocean/FieldStore.luau)
local FieldStore = (function()
--!strict
--!native
-- Field tables from the cascade workers. A worker packs its cascade's eight fields into one
-- buffer (field-major, 32-bit floats) and sends it; the coordinator unpacks it into the
-- "waiting" slot, PROMOTES it on the cascade's own rotation frame (waiting becomes current, the
-- old current becomes previous), and once per frame blends previous and current into display
-- tables that the surface samples. Display tables carry n and size so Cascade.sample works on
-- them unchanged. The store is mutable on purpose: every array is allocated here once and
-- rewritten every frame.
--
-- Three slots, not two, because a result must not reach the display the instant it happens to
-- arrive: a worker answers a frame or two after its request, and a fade driven by those arrivals
-- moves in irregular steps, which Cole saw as jitter in the near water (2026-09-19). The waiting
-- slot lets arrival and display come apart. Arrival fills waiting whenever it happens; promote
-- runs on the fixed three-frame rotation, so the fade downstream can be counted in FRAMES.
--
-- The latency that buys: a result requested at frame F - 3 is promoted at F and fully displayed
-- at F + 2, so the surface shows the sea of about five frames ago. Nothing is synchronised to
-- the clock yet (the swells are off), so nothing can notice; a boat or a splash keyed to the
-- water would be the first thing that could.


-- The sampleable shape, owned by Cascade so there is one definition of it.
type Fields = Cascade.Fields

type Slot = { fields: Fields, time: number, filled: boolean }

type Store = {
	count: number,
	cells: number,
	previous: { Slot },
	current: { Slot },
	waiting: { Slot }, -- the last arrival, not yet on screen; promote moves it into current
	display: { Fields },
	promotedFrame: { number }, -- the frame each cascade last promoted on; 0 before the first
}

local FIELD_NAMES: { string } =
	{ "height", "dispX", "dispZ", "slopeX", "slopeZ", "jxx", "jzz", "jxz" }
local BYTES_PER_VALUE = 4

local FieldStore = {}

FieldStore.FIELD_NAMES = table.freeze(table.clone(FIELD_NAMES))
-- What the surface reads every frame: the coordinator blends all eight now, since the painter's
-- foam reads the Jacobian fields, so this set is the preview's and the sampler's and no longer
-- the blend's.
FieldStore.SURFACE_FIELDS = table.freeze({ "height", "dispX", "dispZ", "slopeX", "slopeZ" })
-- What flat lighting reads: with flatNormals the sampler takes Cascade.sampleHeight, which
-- touches these three alone, so the slopes are two fifths of the blend spent on nothing.
FieldStore.FLAT_FIELDS = table.freeze({ "height", "dispX", "dispZ" })

function FieldStore.bufferSize(cells: number): number
	return #FIELD_NAMES * cells * BYTES_PER_VALUE
end

function FieldStore.newFields(n: number, size: number): Fields
	local cells = n * n
	local fields: any = { n = n, size = size }
	for _, name in FIELD_NAMES do
		fields[name] = table.create(cells, 0)
	end
	return fields
end

local function newSlot(n: number, size: number): Slot
	return { fields = FieldStore.newFields(n, size), time = -1, filled = false }
end

function FieldStore.new(n: number, sizes: { number }): Store
	local previous: { Slot }, current: { Slot }, waiting: { Slot } = {}, {}, {}
	local display: { Fields }, promotedFrame: { number } = {}, {}
	for index, size in sizes do
		previous[index] = newSlot(n, size)
		current[index] = newSlot(n, size)
		waiting[index] = newSlot(n, size)
		display[index] = FieldStore.newFields(n, size)
		promotedFrame[index] = 0
	end
	return {
		count = #sizes,
		cells = n * n,
		previous = previous,
		current = current,
		waiting = waiting,
		display = display,
		promotedFrame = promotedFrame,
	}
end

-- Writes the eight fields of `fields` (a Cascade satisfies Fields) into `out`, field-major.
-- The size check is `if ... then error` and not `assert`: an assert's message is an ARGUMENT, so
-- it would be interpolated on every pack, three times a frame at the High tier, only to be thrown
-- away.
function FieldStore.pack(fields: Cascade.Fields, out: buffer)
	local cells = fields.n * fields.n
	local needed = FieldStore.bufferSize(cells)
	if buffer.len(out) < needed then
		error(`field buffer holds {buffer.len(out)} bytes, needs {needed}`)
	end
	local offset = 0
	for _, name in FIELD_NAMES do
		local values: { number } = (fields :: any)[name]
		for index = 1, cells do
			buffer.writef32(out, offset, values[index])
			offset += BYTES_PER_VALUE
		end
	end
end

-- The size must match exactly: a longer buffer (a worker built with a bigger n) would read in
-- bounds and fill every field with the wrong values instead of failing.
function FieldStore.unpack(input: buffer, fields: Fields)
	local cells = fields.n * fields.n
	local expected = FieldStore.bufferSize(cells)
	-- `if ... then error` for the reason `pack` above gives: an assert's message is an ARGUMENT,
	-- so it would be interpolated on every unpack and thrown away.
	if buffer.len(input) ~= expected then
		error(`field buffer holds {buffer.len(input)} bytes, expected {expected}`)
	end
	local offset = 0
	for _, name in FIELD_NAMES do
		local values: { number } = (fields :: any)[name]
		for index = 1, cells do
			values[index] = buffer.readf32(input, offset)
			offset += BYTES_PER_VALUE
		end
	end
end

-- The buffer fills the WAITING slot, which nothing on screen is reading, and nothing moves: the
-- display keeps showing previous and current until promote is called. A rejected buffer leaves
-- the store exactly as it was, because unpack checks the length before it writes a single value.
-- Two results arriving between two promotions is not an error, just the first one lost.
function FieldStore.receive(store: Store, index: number, input: buffer, t: number)
	local slot = store.waiting[index]
	FieldStore.unpack(input, slot.fields)
	slot.time = t
	slot.filled = true
end

-- Rotates the three slots on the caller's schedule: previous takes the old current, current
-- takes what was waiting, and waiting takes the old previous, whose contents are now two updates
-- stale and free for the next receive to overwrite. Answers false and changes nothing when
-- nothing has arrived, so the display holds instead of restarting a fade over the same pair.
-- A pointer rotation between three fixed tables: nothing is copied and nothing is allocated.
function FieldStore.promote(store: Store, index: number, frame: number): boolean
	local arrived = store.waiting[index]
	if not arrived.filled then
		return false
	end
	local stale = store.previous[index]
	store.previous[index] = store.current[index]
	store.current[index] = arrived
	store.waiting[index] = stale
	stale.filled = false
	store.promotedFrame[index] = frame
	return true
end

function FieldStore.hasFields(store: Store, index: number): boolean
	return store.current[index].filled
end

-- display = previous + (current - previous) * fraction. With only one result, display is a
-- copy of it. With none, the display is left as it is (flat at start). `names` limits the work
-- to the fields the caller reads; the rest keep whatever they last held.
function FieldStore.blend(store: Store, index: number, fraction: number, names: { string }?)
	local previous, current, display =
		store.previous[index], store.current[index], store.display[index]
	if not current.filled then
		return
	end
	local cells = store.cells
	for _, name in names or FIELD_NAMES do
		local to: { number } = (current.fields :: any)[name]
		local out: { number } = (display :: any)[name]
		if previous.filled then
			local from: { number } = (previous.fields :: any)[name]
			for cell = 1, cells do
				local a = from[cell]
				out[cell] = a + (to[cell] - a) * fraction
			end
		else
			table.move(to, 1, cells, 1, out)
		end
	end
end

return table.freeze(FieldStore)
end)()
-- @end FieldStore

-- @module Entry (what the page calls: plain numbers in, plain numbers and hex strings out)
local HEX = table.create(256)
for value = 0, 255 do
	HEX[value + 1] = string.format("%02x", value)
end

-- The bytes of a buffer as lowercase hex, two characters a byte, in buffer order. Built a chunk at
-- a time: the WebAssembly Luau has a fixed heap of about 16 MB that cannot grow, and one table
-- holding a string per byte of a 256 KB buffer would take 4 MB of it at once.
local CHUNK = 4096
local function hex(b: buffer): string
	local count = buffer.len(b)
	local chunks = table.create(math.ceil(count / CHUNK))
	local parts = table.create(CHUNK)
	for start = 0, count - 1, CHUNK do
		local stop = math.min(start + CHUNK, count) - 1
		table.clear(parts)
		for i = start, stop do
			parts[i - start + 1] = HEX[buffer.readu8(b, i) + 1]
		end
		table.insert(chunks, table.concat(parts))
	end
	return table.concat(chunks)
end

-- Spectrum.Params from ten numbers, in the order the page's js/proof/luauRunner.js sends them.
local function params(windSpeed, fetch, depth, gamma, swell, windDirection, gravity, scale, tailBoost, isotropy)
	return table.freeze({
		windSpeed = windSpeed,
		fetch = fetch,
		depth = depth,
		gamma = gamma,
		swell = swell,
		windDirection = windDirection,
		gravity = gravity,
		scale = scale,
		tailBoost = tailBoost,
		isotropy = isotropy,
	})
end

local Entry = {}

function Entry.seedState(seed: number): (number, number, number, number)
	local r = Random.new(seed)
	return r.s0, r.s1, r.s2, r.s3
end

-- `count` draws as one space-separated string, from a seed (b, c, d nil) or from four state words.
function Entry.draws(count: number, a: number, b: number?, c: number?, d: number?): string
	local r = if b == nil then Random.new(a) else Random.fromState(a, b :: number, c :: number, d :: number)
	local values = table.create(count)
	for i = 1, count do
		values[i] = tostring(r:NextU32())
	end
	return table.concat(values, " ")
end

function Entry.lerp(r1, g1, b1, r2, g2, b2, alpha): (number, number, number)
	local c = Color3.new(r1, g1, b1):Lerp(Color3.new(r2, g2, b2), alpha)
	return c.R, c.G, c.B
end

-- One cascade of a three-cascade field, built, evolved to t and synthesised, then packed the way
-- a cascade worker packs it (FieldStore.pack: eight float32 fields, field-major). Answers the
-- packed bytes as hex and the milliseconds the build, evolve and synthesis took.
function Entry.cascade(index, seed, t, n, size1, size2, size3, loopPeriod, ...): (string, number)
	local sizes = { size1, size2, size3 }
	local bands = WaveField.bands(sizes, n)
	local started = os.clock()
	local cascade = Cascade.new({
		n = n,
		size = sizes[index],
		kMin = bands[index].kMin,
		kMax = bands[index].kMax,
		seed = seed * 7919 + index,
		loopPeriod = loopPeriod,
		params = params(...),
	})
	Cascade.evolve(cascade, t)
	Cascade.synthesise(cascade, FFT.plan(n))
	local ms = (os.clock() - started) * 1000
	local packed = buffer.create(FieldStore.bufferSize(n * n))
	FieldStore.pack(cascade, packed)
	return hex(packed), ms
end

-- The painter's maps from the whole three-cascade field at t: the foam field stepped over
-- `foamSteps` colour cycles ending at t (a quarter of its rows at a time, 15 cycles a second,
-- as scripts/m2_preview.py steps it), then the water colour base and the peak mask. Answers the
-- base (RGB bytes), the mask (RGBA bytes) and the foam (float32 per texel) as hex, the mask's
-- largest height, and the milliseconds it all took.
function Entry.maps(seed, t, n, size1, size2, size3, loopPeriod, chop, peak, tint, gamma, whitecap, grow, decay, foamSteps, texels, foamTexels, deepR, deepG, deepB, subR, subG, subB, ...): (string, string, string, number, number)
	local started = os.clock()
	local field = WaveField.new({
		params = params(...),
		n = n,
		sizes = { size1, size2, size3 },
		seed = seed,
		loopPeriod = loopPeriod,
		chop = chop,
		swells = { { wavelength = 420, amplitude = 0, direction = 0.2, phase = 0 } },
	})
	local tile = size1
	local cascades = { 1, 2, 3 }
	local foam = FoamField.newGrid(foamTexels, tile)
	local stepParams = { whitecap = whitecap, grow = grow, decay = decay }
	local quarter = foamTexels // 4
	for k = 1, foamSteps do
		local tk = t - (foamSteps - k) / 15
		for index = 1, 3 do
			WaveField.update(field, index, tk)
		end
		for band = 1, 4 do
			FoamField.stepRows(foam, (band - 1) * quarter, quarter, field.cascades, cascades, tile, chop, stepParams)
		end
	end
	local base = buffer.create(texels * texels * 3)
	local lut = WaterColour.lut(Color3.fromRGB(deepR, deepG, deepB), Color3.fromRGB(subR, subG, subB))
	WaterColour.base(base, texels, tile, field.cascades, cascades, peak, tint, lut)
	local mask = buffer.create(texels * texels * 4)
	local found = PeakMask.fill(mask, texels, tile, field.cascades, cascades, 0, gamma, nil)
	local ms = (os.clock() - started) * 1000
	return hex(base), hex(mask), hex(foam.foam), found, ms
end

return table.freeze(Entry)
-- @end Entry
